<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Famous Shop</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
<header class="navbar">
    <div class="container">
        <a href="/" class="navbar-brand">Famous Shooping Items</a>

        <form action="/" method="GET" class="nav-search-form">
            <input type="text" name="query" placeholder="Search items..." class="nav-search-input">
            <button type="submit" class="btn"><i class="fas fa-search"></i></button>
        </form>
        <a href="/cart" class="nav-link cart-link">
        </a>
    </div>
</header>

<main class="container">
    {{$content}}
    {{/content}}
</main>

<footer class="footer">
    <div class="container">
        <p>&copy; 2025 Famous Shop Raul Michell Sanchez Morales. All reserved rights.</p>
    </div>
</footer>
</body>
</html>