
{{< layout}}

        {{$content}}
<div class="page-title">
    <h1>Your Shopping Cart</h1>
</div>

<div class="cart-layout">
    <div class="cart-items-list">
        {{#cartItems.isEmpty}}
            <div class="cart-empty">
                <p>Your cart is empty.</p>
                <a href="/" class="btn btn-primary">Back to the main page</a>
            </div>
        {{/cartItems.isEmpty}}

        {{^cartItems.isEmpty}}
            {{#cartItems}}
                <div class="cart-item-card">
                  <img src="/images/{{image_url}}" alt="{{name}}" class="cart-item-img">
                    <div class="cart-item-details">
                        <h4 class="cart-item-title">{{name}}</h4>
                        <p class="cart-item-price">{{getFormattedPrice}}</p>
                    </div>

                   <form action="/cart/remove/{{id}}" method="POST" class="cart-item-remove">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i>
                       </button>
                </form>
                </div>
            {{/cartItems}}
        {{/cartItems.isEmpty}}
    </div>

    {{^cartItems.isEmpty}}
        <div class="cart-summary">
            <h3>Summary</h3>
            <div class="summary-row">
                <span>Subtotal ({{cartCount}} items)</span>
                <span class="summary-total">${{cartTotal}}</span>
            </div>
            <button class="btn btn-primary btn-full">Proceed to Checkout</button>
        </div>
    {{/cartItems.isEmpty}}
</div>
    {{/content}}

{{/layout}}
