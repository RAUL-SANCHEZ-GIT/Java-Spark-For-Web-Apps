{{< layout}}

    {{$content}}
        <div class="page-title">
            <h1>Latest Products</h1>
            <p>Exclusive Items From Your Favorite Artists.</p>
        </div>

        <div class="item-grid">
            {{#items}}
                <div class="item-card">
                    <div class="item-card-image">
                        <img src="https://placehold.co/400x300/e2e8f0/334155?text={{name}}" alt="{{name}}">
                    </div>
                    <div class="item-card-content">
                        <h3 class="item-card-title">{{name}}</h3>
                        <p class="item-card-price">{{getFormattedPrice}}</p>
                        <p class="item-card-description">{{description}}</p>

                        <form action="/cart/add/{{id}}" method="POST">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-cart-plus"></i> Add To The Cart
                            </button>
                        </form>
                    </div>
                </div>
            {{/items}}
        </div>

    {{/content}}

{{/layout}}